# ─── App ──────────────────────────────────────────────────────────────────────
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─── PostgreSQL (docker-compose — porta host 5433) ───────────────────────────
DATABASE_URL="postgresql://logos:logos_dev@localhost:5433/logos_financeiro?schema=public"

# ─── Redis / BullMQ (docker-compose — porta host 6380) ───────────────────────
REDIS_URL="redis://localhost:6380"

# ─── Cron — motor de alertas financeiros (Sprint 9) ──────────────────────────
# Gerar: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Agendamento sugerido: 0 6 * * *  →  npm run alerts:engine
# Ou: POST /api/cron/financial-alerts com Authorization: Bearer <CRON_SECRET>
CRON_SECRET=

# ─── Auth.js (NextAuth v5) ───────────────────────────────────────────────────
AUTH_SECRET="gere-um-segredo-com-openssl-rand-base64-32"
AUTH_URL="http://localhost:3000"
AUTH_DEV_PASSWORD="dev123"

# OAuth providers (opcional)
# AUTH_GOOGLE_ID=""
# AUTH_GOOGLE_SECRET=""

# ─── Gemini (NLP / transcrição / PDF) ────────────────────────────────────────
# https://aistudio.google.com/apikey
GEMINI_API_KEY="sua_chave_do_google_ai_studio"
GEMINI_MODEL="gemini-2.5-flash"

# ─── Groq (IA Advisor — primário) ────────────────────────────────────────────
GROQ_API_KEY=""
GROQ_MODEL="llama-3.3-70b-versatile"

# ─── OpenRouter (IA Advisor — fallback gratuito) ─────────────────────────────
OPENROUTER_API_KEY=""
OPENROUTER_MODEL="openrouter/auto"

# ─── Telegram (Sprint 4.7) ───────────────────────────────────────────────────
# Token: @BotFather
TELEGRAM_BOT_TOKEN=""
# Secret do webhook (header X-Telegram-Bot-Api-Secret-Token):
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TELEGRAM_WEBHOOK_SECRET=""
#
# Webhook (Telegram não chama localhost):
#   https://<seu-tunnel>.ngrok-free.app/api/telegram/webhook
# Registrar:
#   curl "https://api.telegram.org/bot<TOKEN>/setWebhook?url=<URL>&secret_token=<TELEGRAM_WEBHOOK_SECRET>"
#
# Vincular conta no app: Cadastros → Integrações → gerar código → no Telegram: /connect ABC123
#
# Pausa entre etapas do dev:all (ms) — útil em pastas OneDrive (padrão 2500). Desativar: 0
# DEV_ONEDRIVE_PAUSE_MS=2500
#
# Ambiente local completo (Docker + Next + worker + ngrok + webhook):
#   npm run dev:all
# Re-registrar webhook após reiniciar o ngrok:
#   npm run telegram:webhook
