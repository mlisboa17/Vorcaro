# ─── App ──────────────────────────────────────────────────────────────────────
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─── PostgreSQL (docker-compose) ─────────────────────────────────────────────
DATABASE_URL="postgresql://logos:logos_dev@localhost:5432/logos_financeiro?schema=public"

# ─── Redis / BullMQ (docker-compose) ─────────────────────────────────────────
REDIS_URL="redis://localhost:6379"

# ─── Auth.js (NextAuth v5) ───────────────────────────────────────────────────
AUTH_SECRET="gere-um-segredo-com-openssl-rand-base64-32"
AUTH_URL="http://localhost:3000"
AUTH_DEV_PASSWORD="dev123"

# OAuth providers (opcional no MVP — descomente quando configurar)
# AUTH_GOOGLE_ID=""
# AUTH_GOOGLE_SECRET=""

# ─── Gemini (Motor IA — NLP) ─────────────────────────────────────────────────
# Chave obtida em https://aistudio.google.com/apikey
GEMINI_API_KEY="sua_chave_do_google_ai_studio"
GEMINI_MODEL="gemini-1.5-flash"

# ─── Telegram (Webhook Adapter — Passo 8) ────────────────────────────────────
# Token obtido via @BotFather ao criar o bot.
# Configure o webhook apontando para:
#   https://<seu-dominio>/api/webhooks/telegram?token=<TELEGRAM_BOT_TOKEN>
TELEGRAM_BOT_TOKEN=""
