generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Auth.js (NextAuth) ───────────────────────────────────────────────────────

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  emailVerified DateTime?
  image         String?
  passwordHash  String?
  vorcaroTone   VorcaroTone @default(PROFESSIONAL)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  authAccounts     Account[]
  sessions         Session[]
  passwordResetTokens PasswordResetToken[]
  financialAccounts FinancialAccount[]
  cards            Card[]
  transactions     Transaction[]
  categories       Category[]
  paymentMethods   PaymentMethod[]
  inboxItems       FinancialInbox[]
  userRules        UserRule[]
  learningPatterns UserLearningPattern[]
  lancamentosRecorrentes LancamentoRecorrente[]
  patrimonyAssets      PatrimonyAsset[]
  patrimonyLiabilities PatrimonyLiability[]
  patrimonyTransactions PatrimonyTransaction[]
  consortiums          Consortium[]
  telegramConnections  TelegramConnection[]
  telegramConnectCodes TelegramConnectCode[]
  financialGoals       FinancialGoal[]
  receivables          Receivable[]
  financialAlerts              FinancialAlert[]
  advisorRecommendationStates  AdvisorRecommendationState[]
  notifications                Notification[]
  notificationPreferences      NotificationPreference[]
  vorcaroMessageHistory        VorcaroMessageHistory[]
  vorcaroConversations         VorcaroConversation[]
  financialTimelineEvents      FinancialTimelineEvent[]
  financialMetricSnapshots     FinancialMetricSnapshot[]
  financialAchievements        FinancialAchievement[]
  vorcaroActionProposals       VorcaroActionProposal[]
  vorcaroFollowUps             VorcaroFollowUp[]
  financialDocuments           FinancialDocument[]
  financialDocumentLearningPatterns FinancialDocumentLearningPattern[]
  financialDocumentAuditEvents FinancialDocumentAuditEvent[]
}

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
}

model Session {
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@id([identifier, token])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  token     String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

// ─── Domínio Financeiro ───────────────────────────────────────────────────────

model FinancialAccount {
  id              String      @id @default(cuid())
  userId          String
  name            String
  institutionName String?
  type            AccountType
  currency        String      @default("BRL")
  balance         Decimal     @default(0) @db.Decimal(15, 2)
  isActive        Boolean     @default(true)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  cards        Card[]
  transactions Transaction[]
  lancamentosRecorrentes LancamentoRecorrente[]

  @@unique([userId, name])
  @@index([userId])
}

enum AccountType {
  CHECKING
  SAVINGS
  CREDIT_CARD
  CASH
  INVESTMENT
  OTHER
  CORRENTE
  CONTA_CORRENTE
  POUPANCA
  INVESTIMENTO
  CARTEIRA_DIGITAL
  CARTEIRA_DINHEIRO
  INTERNACIONAL
  PJ
}

model Card {
  id                 String     @id @default(cuid())
  userId             String
  financialAccountId String?
  name               String
  institutionName    String?
  brand              CardBrand
  type               CardType
  lastFourDigits     String?
  creditLimit        Decimal?   @db.Decimal(15, 2)
  closingDay         Int?
  dueDay             Int?
  isActive           Boolean    @default(true)
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt

  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  financialAccount FinancialAccount? @relation(fields: [financialAccountId], references: [id], onDelete: SetNull)
  transactions     Transaction[]
  lancamentosRecorrentes LancamentoRecorrente[]

  @@unique([userId, name])
  @@index([userId])
  @@index([financialAccountId])
}

enum CardBrand {
  VISA
  MASTERCARD
  ELO
  AMEX
  HIPERCARD
  OTHER
}

enum CardType {
  CREDITO
  DEBITO
  MULTIPLO
}

enum CategoryType {
  RECEITA
  DESPESA
}

model Category {
  id               String       @id @default(cuid())
  userId           String
  name             String
  type             CategoryType
  icon             String?
  color            String?
  isSystem         Boolean      @default(false)
  isActive         Boolean      @default(true)
  parentCategoryId String?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  parentCategory Category?    @relation("CategoryHierarchy", fields: [parentCategoryId], references: [id], onDelete: Restrict)
  subcategories Category[]    @relation("CategoryHierarchy")
  transactions  Transaction[]
  lancamentosRecorrentes LancamentoRecorrente[]

  @@unique([userId, name, parentCategoryId])
  @@index([userId])
  @@index([userId, isActive])
  @@index([parentCategoryId])
}

enum TransactionType {
  INCOME
  EXPENSE
  TRANSFER
}

model PaymentMethod {
  id        String            @id @default(cuid())
  userId    String
  name      String
  type      PaymentMethodType
  isDefault Boolean           @default(false)
  isActive  Boolean           @default(true)
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions Transaction[]
  lancamentosRecorrentes LancamentoRecorrente[]

  @@unique([userId, name])
  @@index([userId])
}

enum PaymentMethodType {
  PIX
  CREDIT_CARD
  DEBIT_CARD
  CASH
  BANK_TRANSFER
  BOLETO
  OTHER
  DINHEIRO
  CARTAO
  CARTAO_CREDITO
  CARTAO_DEBITO
  TRANSFERENCIA
  TRANSFERENCIA_BANCARIA
  CARTEIRA_DIGITAL
  DEBITO_AUTOMATICO
}

model Transaction {
  id                 String          @id @default(cuid())
  userId             String
  accountId          String?
  categoryId         String?
  paymentMethodId    String?
  cardId             String?
  inboxItemId        String?         @unique
  type               TransactionType
  amount             Decimal         @db.Decimal(15, 2)
  description        String
  date               DateTime
  dataCompra         DateTime?
  dataCaixa          DateTime?
  dataVencimentoFatura DateTime?
  notes              String?
  metadata           Json?
  installments       Int             @default(1)
  installmentGroup   String?
  currentInstallment Int?
  totalInstallments  Int?
  numeroParcela      Int?
  totalParcelas      Int?
  idGrupoParcelamento String?
  observacoesInternas String?
  lancamentoRecorrenteId String?
  dataRecorrencia        DateTime?
  liabilityId            String?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  user          User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  liability     PatrimonyLiability? @relation(fields: [liabilityId], references: [id], onDelete: SetNull)
  account       FinancialAccount? @relation(fields: [accountId], references: [id])
  category      Category?         @relation(fields: [categoryId], references: [id])
  paymentMethod PaymentMethod?    @relation(fields: [paymentMethodId], references: [id])
  card          Card?             @relation(fields: [cardId], references: [id])
  inboxItem     FinancialInbox?   @relation(fields: [inboxItemId], references: [id])
  lancamentoRecorrente LancamentoRecorrente? @relation(fields: [lancamentoRecorrenteId], references: [id], onDelete: SetNull)
  patrimonyTransactions PatrimonyTransaction[]
  receivable            Receivable?

  @@index([userId, date])
  @@index([accountId])
  @@index([cardId])
  @@index([installmentGroup])
  @@index([lancamentoRecorrenteId, dataRecorrencia])
  @@index([liabilityId])
}

// ─── Lançamentos Recorrentes ──────────────────────────────────────────────────

enum FrequenciaRecorrencia {
  SEMANAL
  QUINZENAL
  MENSAL
  BIMESTRAL
  TRIMESTRAL
  SEMESTRAL
  ANUAL
}

enum TipoLancamentoRecorrente {
  RECEITA
  DESPESA
}

model LancamentoRecorrente {
  id                 String                   @id @default(cuid())
  userId             String
  descricao          String
  tipo               TipoLancamentoRecorrente
  valor              Decimal                  @db.Decimal(15, 2)
  frequencia         FrequenciaRecorrencia
  dataInicio         DateTime
  dataFim            DateTime?
  proximaExecucao    DateTime
  estaAtivo          Boolean                  @default(true)
  categoryId         String
  financialAccountId String
  paymentMethodId    String
  cardId             String?
  observacoes        String?
  liabilityId        String?
  defaultAllocations Json?
  diaInicioOriginal  Int
  createdAt          DateTime                 @default(now())
  updatedAt          DateTime                 @updatedAt

  user             User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  liability        PatrimonyLiability? @relation(fields: [liabilityId], references: [id], onDelete: SetNull)
  category         Category         @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  financialAccount FinancialAccount @relation(fields: [financialAccountId], references: [id], onDelete: Restrict)
  paymentMethod    PaymentMethod    @relation(fields: [paymentMethodId], references: [id], onDelete: Restrict)
  card             Card?            @relation(fields: [cardId], references: [id], onDelete: SetNull)
  transactions     Transaction[]
  consortiums      Consortium[]

  @@index([userId, estaAtivo, proximaExecucao])
  @@index([userId])
  @@index([liabilityId])
}

// ─── Caixa Financeira (Financial Inbox) ───────────────────────────────────────

enum InboxStatus {
  PENDING
  PROCESSING
  READY
  NEEDS_CONFIRMATION
  SAVED
  ERROR
}

enum InboxChannel {
  WEB
  WEB_VOICE
  WEB_IMAGE
  WEB_IMPORT
  TELEGRAM
  TELEGRAM_VOICE
  TELEGRAM_IMAGE
  WHATSAPP
}

model FinancialInbox {
  id           String       @id @default(cuid())
  userId       String
  status       InboxStatus  @default(PENDING)
  channel      InboxChannel
  rawContent   String       @db.Text
  channelMeta  Json?
  metadata     Json?
  externalId   String?
  importHash   String?
  errorMessage String?
  processedAt  DateTime?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  user              User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  attachments       Attachment[]
  extractionResults ExtractionResult[]
  transaction       Transaction?

  @@index([userId, status])
  @@index([status, createdAt])
  @@index([userId, channel, externalId])
  @@index([userId, channel, importHash])
}

model Attachment {
  id          String   @id @default(cuid())
  inboxItemId String
  fileName    String
  mimeType    String
  storageKey  String
  sizeBytes   Int
  createdAt   DateTime @default(now())

  inboxItem         FinancialInbox     @relation(fields: [inboxItemId], references: [id], onDelete: Cascade)
  extractionResults ExtractionResult[]

  @@index([inboxItemId])
}

model ExtractionResult {
  id            String   @id @default(cuid())
  inboxItemId   String
  attachmentId  String?
  provider      String
  extractedData Json
  confidence    Json
  tokensUsed    Int?
  processingMs  Int?
  createdAt     DateTime @default(now())

  inboxItem  FinancialInbox @relation(fields: [inboxItemId], references: [id], onDelete: Cascade)
  attachment Attachment?    @relation(fields: [attachmentId], references: [id], onDelete: SetNull)

  @@index([inboxItemId])
}

// ─── Motor de Aprendizado ─────────────────────────────────────────────────────

model UserRule {
  id          String   @id @default(cuid())
  userId      String
  name        String
  description String?
  condition   Json
  action      Json
  priority    Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isActive])
}

model UserLearningPattern {
  id           String   @id @default(cuid())
  userId       String
  patternType  String
  inputSignal  Json
  outputSignal Json
  confidence   Float
  occurrences  Int      @default(1)
  lastSeenAt   DateTime @default(now())
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, patternType])
}

// ─── Patrimônio ───────────────────────────────────────────────────────────────

enum AssetType {
  CONSORCIO
  INVESTIMENTO
  BEM
  DIREITO_RECEBER
  ADIANTAMENTO
  VEHICLE
  REAL_ESTATE
  INVESTMENT
  CONSORTIUM
  RECEIVABLE
  OTHER
}

enum LiabilityType {
  EMPRESTIMO
  FINANCIAMENTO
  OBRIGACAO
  FINANCING
  LOAN
  CREDIT_LINE
  OTHER
}

enum PatrimonyTxType {
  APORTE
  RESGATE
  AMORTIZACAO
  JUROS
  SEGURO
  TAXA
  CORRECAO
  RENDIMENTO
  DEPRECIACAO
}

model PatrimonyAsset {
  id             String    @id @default(cuid())
  userId         String
  nome           String
  descricao      String?
  tipo           AssetType
  valorAquisicao Decimal   @db.Decimal(15, 2)
  valorAtual     Decimal   @db.Decimal(15, 2)
  dataAquisicao  DateTime?
  estaAtivo      Boolean   @default(true)
  observacoes    String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  linkedLiabilityId String? @map("liabilityId")
  linkedLiability   PatrimonyLiability? @relation(fields: [linkedLiabilityId], references: [id], onDelete: SetNull)

  user            User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  movimentacoes   PatrimonyTransaction[]
  consortium      Consortium?

  @@index([userId, estaAtivo])
  @@index([userId, tipo])
}

// ─── Consórcios ───────────────────────────────────────────────────────────────

enum ConsortiumType {
  VEHICLE
  REAL_ESTATE
  SERVICE
  OTHER
}

enum ConsortiumStatus {
  NOT_CONTEMPLATED
  CONTEMPLATED
  ASSET_ACQUIRED
  COMPLETED
}

model Consortium {
  id                    String           @id @default(cuid())
  userId                String
  nome                  String
  tipo                  ConsortiumType
  status                ConsortiumStatus
  valorCredito          Decimal          @db.Decimal(15, 2)
  valorLance            Decimal          @db.Decimal(15, 2) @default(0)
  valorPago             Decimal          @db.Decimal(15, 2) @default(0)
  valorTaxas            Decimal          @db.Decimal(15, 2) @default(0)
  quantidadeParcelas    Int
  parcelasPagas         Int              @default(0)
  dataContratacao       DateTime?
  dataContemplacao      DateTime?
  dataQuitacao          DateTime?
  assetId               String?          @unique
  lancamentoRecorrenteId String?
  estaAtivo             Boolean          @default(true)
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt

  usuario               User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  asset                 PatrimonyAsset?      @relation(fields: [assetId], references: [id], onDelete: SetNull)
  lancamentoRecorrente  LancamentoRecorrente? @relation(fields: [lancamentoRecorrenteId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([userId, estaAtivo])
  @@index([userId, status])
}

model PatrimonyLiability {
  id                   String        @id @default(cuid())
  userId               String
  nome                 String
  descricao            String?
  tipo                 LiabilityType
  saldoOriginal        Decimal       @db.Decimal(15, 2)
  saldoAtual           Decimal       @db.Decimal(15, 2)
  taxaJuros            Decimal?      @db.Decimal(8, 4)
  dataContratacao      DateTime?
  dataQuitacaoPrevista DateTime?
  estaAtivo            Boolean       @default(true)
  observacoes          String?
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  user                    User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  assets                  PatrimonyAsset[]
  movimentacoes           PatrimonyTransaction[]
  transactions            Transaction[]
  lancamentosRecorrentes  LancamentoRecorrente[]

  @@index([userId, estaAtivo])
  @@index([userId, tipo])
}

model PatrimonyTransaction {
  id                String          @id @default(cuid())
  userId            String
  assetId           String?
  liabilityId       String?
  tipo              PatrimonyTxType
  valorTotal        Decimal         @db.Decimal(15, 2)
  data              DateTime
  descricao         String?
  mainTransactionId String?
  createdAt         DateTime        @default(now())

  user            User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  asset           PatrimonyAsset?     @relation(fields: [assetId], references: [id], onDelete: SetNull)
  liability       PatrimonyLiability? @relation(fields: [liabilityId], references: [id], onDelete: SetNull)
  mainTransaction Transaction?        @relation(fields: [mainTransactionId], references: [id], onDelete: SetNull)

  @@index([userId, data])
  @@index([assetId])
  @@index([liabilityId])
  @@index([mainTransactionId])
}

// ─── Planejamento financeiro (Sprint 6) ───────────────────────────────────────

enum FinancialGoalType {
  EMERGENCY_FUND
  VEHICLE
  REAL_ESTATE
  DEBT_SETTLEMENT
  EDUCATION
  RETIREMENT
  CUSTOM
}

enum GoalPriority {
  LOW
  MEDIUM
  HIGH
}

enum GoalStatus {
  ACTIVE
  ACHIEVED
  CANCELLED
}

model FinancialGoal {
  id            String            @id @default(cuid())
  userId        String
  nome          String
  descricao     String?
  tipo          FinancialGoalType
  valorObjetivo Decimal           @db.Decimal(15, 2)
  valorAtual    Decimal           @default(0) @db.Decimal(15, 2)
  aporteMensal  Decimal?          @db.Decimal(15, 2)
  dataObjetivo  DateTime?
  prioridade    GoalPriority
  status        GoalStatus        @default(ACTIVE)
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, status])
}

// ─── Telegram (Sprint 4.7) ────────────────────────────────────────────────────

model TelegramConnection {
  id             String   @id @default(cuid())
  userId         String
  telegramChatId BigInt
  telegramUserId BigInt?
  username       String?
  firstName      String?
  isActive       Boolean  @default(true)
  connectedAt    DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([telegramChatId])
  @@index([userId])
}

model TelegramConnectCode {
  id        String    @id @default(cuid())
  userId    String
  code      String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

// ─── Contas a Receber (Sprint 7.5) ────────────────────────────────────────────

enum ReceivableStatus {
  OPEN
  PARTIALLY_RECEIVED
  RECEIVED
  CANCELLED
}

model Receivable {
  id              String           @id @default(cuid())
  userId          String
  descricao       String
  devedorNome     String
  valorOriginal   Decimal          @db.Decimal(15, 2)
  valorRecebido   Decimal          @default(0) @db.Decimal(15, 2)
  valorPendente   Decimal          @db.Decimal(15, 2)
  status          ReceivableStatus @default(OPEN)
  origem          String?
  observacoes     String?
  expectedDate    DateTime?
  receivedAt      DateTime?
  transactionId   String?          @unique
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  transaction Transaction? @relation(fields: [transactionId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([status])
  @@index([userId, expectedDate])
}

// ─── Alertas Financeiros (Sprint 9) ───────────────────────────────────────────

enum FinancialAlertType {
  UPCOMING_PAYMENT
  OVERDUE_RECEIVABLE
  CREDIT_CARD_RISK
  CASHFLOW_WARNING
  GOAL_AT_RISK
  HIGH_COMMITMENT_MONTH
  REIMBURSEMENT_DELAY
}

enum FinancialAlertSeverity {
  INFO
  WARNING
  CRITICAL
}

enum FinancialAlertStatus {
  OPEN
  DISMISSED
  RESOLVED
}

model FinancialAlert {
  id          String                 @id @default(cuid())
  userId      String
  type        FinancialAlertType
  severity    FinancialAlertSeverity
  title       String
  description String                 @db.Text
  status      FinancialAlertStatus   @default(OPEN)
  fingerprint String
  metadata    Json?
  actionUrl   String?
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt
  resolvedAt  DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, fingerprint])
  @@index([userId, status])
  @@index([userId, type])
  @@index([userId, severity])
  @@index([createdAt])
}

// ─── Consultor Financeiro — memória de recomendações (Sprint 9.5A) ───────────

enum AdvisorRecommendationStatus {
  PENDING
  DISMISSED
  CLICKED
}

enum DismissReason {
  NOT_RELEVANT
  ALREADY_HANDLED
  ACCEPTED_SPENDING
  REMIND_LATER
}

model AdvisorRecommendationState {
  id                 String                      @id @default(cuid())
  userId             String
  recommendationHash String
  actionType         String
  status             AdvisorRecommendationStatus @default(PENDING)
  dismissReason      DismissReason?
  dismissedUntil     DateTime?
  clickedAt          DateTime?
  clickCount         Int                         @default(0)
  createdAt          DateTime                    @default(now())
  updatedAt          DateTime                    @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, recommendationHash])
  @@index([userId, status])
  @@index([userId, dismissedUntil])
}

// ─── Central de Notificações (Sprint 10) ────────────────────────────────────

enum NotificationType {
  ALERT_CREATED
  RECOMMENDATION_CREATED
  RECEIVABLE_OVERDUE
  GOAL_AT_RISK
  CASHFLOW_WARNING
  HIGH_COMMITMENT_MONTH
  DUPLICATE_SUBSCRIPTION
  MONEY_LEAK
  DAILY_DIGEST
  WEEKLY_DIGEST
}

enum NotificationSeverity {
  INFO
  WARNING
  CRITICAL
}

enum NotificationStatus {
  PENDING
  SENT
  READ
  DISMISSED
  FAILED
}

enum NotificationChannel {
  DASHBOARD
  TELEGRAM
  DIGEST
}

model Notification {
  id          String               @id @default(cuid())
  userId      String
  type        NotificationType
  severity    NotificationSeverity
  status      NotificationStatus   @default(PENDING)
  title       String
  message     String               @db.Text
  channel     NotificationChannel
  fingerprint String
  payload     Json?
  createdAt   DateTime             @default(now())
  sentAt      DateTime?
  readAt      DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, fingerprint])
  @@index([userId, status])
  @@index([userId, channel])
  @@index([userId, type])
  @@index([userId, severity])
  @@index([createdAt])
}

model NotificationPreference {
  id                String           @id @default(cuid())
  userId            String
  notificationType  NotificationType
  dashboardEnabled  Boolean          @default(true)
  telegramEnabled   Boolean          @default(false)
  digestEnabled     Boolean          @default(true)
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, notificationType])
  @@index([userId])
}

// ─── Vorcaro — personalidade e anti-repetição (Sprint 10.5) ───────────────────

enum VorcaroTone {
  PROFESSIONAL
  DIRECT
  BALANCED
  VORCARO
  IMPACT
  REALITY_AUDITOR
}

model VorcaroMessageHistory {
  id         String   @id @default(cuid())
  userId     String
  templateId String
  category   String
  usedAt     DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, usedAt])
  @@index([userId, templateId])
  @@index([userId, category])
}

// ─── Vorcaro Chat — Sprint 11 ─────────────────────────────────────────────────

enum VorcaroConversationChannel {
  WEB
  TELEGRAM
}

enum VorcaroMessageRole {
  USER
  VORCARO
  SYSTEM
}

model VorcaroConversation {
  id          String                   @id @default(cuid())
  userId      String
  channel     VorcaroConversationChannel
  title       String?
  activeTopic String?
  createdAt   DateTime                 @default(now())
  updatedAt   DateTime                 @updatedAt

  user     User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages VorcaroMessage[]

  @@index([userId, channel])
  @@index([userId, updatedAt])
}

model VorcaroMessage {
  id             String             @id @default(cuid())
  conversationId String
  role           VorcaroMessageRole
  content        String             @db.Text
  metadata       Json?
  createdAt      DateTime           @default(now())

  conversation VorcaroConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
}

// ─── Memória Financeira Longitudinal — Sprint 12 ───────────────────────────────

enum FinancialTimelineEventType {
  NET_WORTH_INCREASE
  NET_WORTH_DECREASE
  GOAL_PROGRESS
  GOAL_COMPLETED
  GOAL_AT_RISK
  DEBT_REDUCTION
  DEBT_INCREASE
  CASHFLOW_IMPROVEMENT
  CASHFLOW_DETERIORATION
  SPENDING_REDUCTION
  SPENDING_INCREASE
  SUBSCRIPTION_CANCELLED
  SUBSCRIPTION_CREATED
  MONEY_LEAK_DETECTED
  MONEY_LEAK_RESOLVED
  MILESTONE
}

enum FinancialTimelineImpactLevel {
  LOW
  MEDIUM
  HIGH
}

enum FinancialTrendDirection {
  IMPROVING
  STABLE
  DECLINING
}

model FinancialTimelineEvent {
  id          String                       @id @default(cuid())
  userId      String
  eventType   FinancialTimelineEventType
  title       String
  description String                       @db.Text
  eventDate   DateTime
  impactLevel FinancialTimelineImpactLevel
  metadata    Json?
  fingerprint String
  createdAt   DateTime                     @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, fingerprint])
  @@index([userId, eventDate])
  @@index([userId, eventType])
}

model FinancialMetricSnapshot {
  id                String   @id @default(cuid())
  userId            String
  snapshotDate      DateTime @db.Date
  healthScore       Int
  netWorth          Decimal  @db.Decimal(15, 2)
  totalDebt         Decimal  @db.Decimal(15, 2)
  monthlyIncome     Decimal  @db.Decimal(15, 2)
  monthlyExpenses   Decimal  @db.Decimal(15, 2)
  monthlyCashflow   Decimal  @db.Decimal(15, 2)
  createdAt         DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, snapshotDate])
  @@index([userId, snapshotDate])
}

model FinancialAchievement {
  id             String   @id @default(cuid())
  userId         String
  achievementKey String
  title          String
  description    String   @db.Text
  unlockedAt     DateTime @default(now())
  metadata       Json?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, achievementKey])
  @@index([userId, unlockedAt])
}

// ─── Execução Assistida Vorcaro — Sprint 13 ───────────────────────────────────

enum VorcaroActionStatus {
  PENDING
  APPROVED
  REJECTED
  EXECUTED
  FAILED
  EXPIRED
}

model VorcaroActionProposal {
  id            String              @id @default(cuid())
  userId        String
  actionType    String
  title         String
  description   String
  payload       Json
  status        VorcaroActionStatus @default(PENDING)

  approvedAt    DateTime?
  executedAt    DateTime?
  failedAt      DateTime?
  expiresAt     DateTime

  failureReason String?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
}

// ─── Follow-up Inteligente — Sprint 14 ────────────────────────────────────────

enum VorcaroFollowUpStatus {
  PENDING
  ACTIVE
  COMPLETED
  DISMISSED
  EXPIRED
}

model VorcaroFollowUp {
  id                String                @id @default(cuid())
  userId            String
  fingerprint       String
  relatedEntityId   String?
  relatedEntityType String?
  title             String
  description       String
  status            VorcaroFollowUpStatus @default(PENDING)
  nextCheckAt       DateTime
  lastReminderAt    DateTime?
  checkCount        Int                   @default(0)
  version           Int                   @default(0)
  metadata          Json?
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, fingerprint])
  @@index([userId, status])
  @@index([nextCheckAt])
}

// ─── Captura Inteligente de Documentos — Sprint 15 ────────────────────────────

enum FinancialDocumentStatus {
  UPLOADED
  PROCESSING
  EXTRACTED
  REVIEW_REQUIRED
  PASSWORD_REQUIRED
  APPROVED
  REJECTED
  FAILED
}

enum TransactionMethod {
  PIX
  TRANSFERENCIA
  BOLETO
  CARTAO_CREDITO
  OUTROS
}

enum FinancialDocumentSuggestionStatus {
  PENDING
  APPROVED
  EDITED
  REJECTED
}

model FinancialDocument {
  id            String                  @id @default(cuid())
  userId        String
  fileName      String
  mimeType      String
  fileSize      Int
  storageKey    String?
  fingerprint   String
  status        FinancialDocumentStatus @default(UPLOADED)

  extractedText String?                 @db.Text
  extractedJson Json?
  method        TransactionMethod?

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user          User @relation(fields: [userId], references: [id], onDelete: Cascade)
  suggestions   FinancialDocumentSuggestion[]
  auditEvents   FinancialDocumentAuditEvent[]

  @@unique([userId, fingerprint])
  @@index([userId, status])
}

model FinancialDocumentSuggestion {
  id               String                            @id @default(cuid())
  userId           String
  documentId       String
  status           FinancialDocumentSuggestionStatus @default(PENDING)

  amount           Decimal?                          @db.Decimal(15, 2)
  date             DateTime?
  description      String?
  supplier         String?
  method           TransactionMethod?
  categoryId       String?
  subcategoryId    String?
  confidence       Int
  isLearnedPattern Boolean                           @default(false)

  metadata         Json?

  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  document         FinancialDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@index([documentId])
}

model FinancialDocumentLearningPattern {
  id              String            @id @default(cuid())
  userId          String

  method          TransactionMethod
  pixKey          String?
  documentNumber  String?
  normalizedName  String?

  categoryId      String?
  subcategoryId   String?

  occurrences     Int               @default(1)
  lastUsedAt      DateTime?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  user            User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, method])
}

enum FinancialDocumentAuditAction {
  EDITED
  APPROVED
  REJECTED
  REPROCESS_REQUESTED
  REPROCESS_SUCCEEDED
  REPROCESS_FAILED
  REOPENED_AFTER_REJECTION
  PASSWORD_SUBMITTED
}

model FinancialDocumentAuditEvent {
  id            String                        @id @default(cuid())
  userId        String
  documentId    String
  suggestionId  String?
  action        FinancialDocumentAuditAction
  changedFields Json?
  createdAt     DateTime                      @default(now())

  user          User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  document      FinancialDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([userId, documentId])
  @@index([suggestionId])
}
